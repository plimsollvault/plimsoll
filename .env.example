# Copy to .env and fill in. Never commit .env.

# RPC used by Hardhat and the agent. The official endpoint served an expired certificate on 2026-11-24.
ROBINHOOD_RPC=https://rpc.nodeflare.app/robinhood/public

# Deploy (run once, from your own machine)
DEPLOYER_KEY=            # wallet that pays for deployment; it keeps no power afterwards
AGENT_ADDRESS=           # address of the agent wallet (a separate wallet)
GUARDIAN_ADDRESS=        # can pause deposits/trading, nothing else. Defaults to the deployer
DEPOSIT_CAP_USDG=10000
PROPOSAL_THRESHOLD_SHARES=100
TIMELOCK_SECONDS=259200

# Agent (runs all the time on a server)
AGENT_KEY=               # private key of AGENT_ADDRESS; keep a small ETH balance for gas
VAULT_ADDRESS=           # from deployments/robinhood.json
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
